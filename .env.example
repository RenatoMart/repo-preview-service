# Copiar a .env y ajustar. cmd/server lee estas variables del entorno del
# proceso (usa `set -a; source .env; set +a` o un runner que cargue .env,
# go run no lo hace solo).

PORT=8080
DATA_DIR=./data
CATALOG_PATH=./configs/projects.yaml

# PAT sin scopes (solo lectura pública): sube el límite de la API de
# GitHub de 60 a 5000 peticiones/hora. Sin esto el servicio funciona
# igual, solo con menos margen.
GITHUB_TOKEN=

# Secreto configurado también en GitHub → repo → Settings → Webhooks.
# Sin esto, POST /api/v1/webhooks/github rechaza todas las peticiones en
# vez de aceptar payloads sin verificar.
GITHUB_WEBHOOK_SECRET=

# Protege POST /api/v1/admin/refresh (cabecera X-Admin-Token). Sin esto,
# el endpoint rechaza todas las peticiones.
ADMIN_TOKEN=

CORS_ALLOWED_ORIGINS=http://localhost:3000,https://renato-martinez-rose.vercel.app

REFRESH_INTERVAL=30m

# Dónde cmd/shooter (vía GitHub Actions) commitea data/screenshots/*.png.
# El servidor arma la URL de jsDelivr a partir de esto; no hace falta
# tocarlo salvo que renombres o forkees el repo.
SCREENSHOTS_REPO=RenatoMart/repo-preview-service
SCREENSHOTS_BRANCH=main
